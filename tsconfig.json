{
  "extends": "./tsconfig.base.json",
  "compilerOptions": { "allowJs": true },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.tsx",
    "packages/core/src/**/*.mjs",
    "packages/plugin/hooks/lib/**/*.ts",
    "packages/*/scripts/**/*.ts",
    "packages/*/test/**/*.ts",
    "packages/*/test/**/*.tsx",
    "demos/*/src/**/*.ts",
    "demos/*/scripts/**/*.ts",
    "cookbook/**/*.ts",
    "scripts/**/*.ts",
    "infra/project-machine/**/*.ts"
  ],
  "exclude": ["**/node_modules", "**/dist", "**/build"]
}
